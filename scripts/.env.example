# Copy to .env and fill in. .env is git-ignored and never committed.

# Required: OpenAI API key used for filename + sidecar generation.
OPENAI_API_KEY=replace-openai-api-key

# Model (must support Structured Outputs json_schema). gpt-4.1-mini is a good default.
OPENAI_MODEL=gpt-4.1-mini

# Optional tuning.
# MAX_OCR_CHARS=32000      # OCR chars sent to the model; the rest is still kept verbatim in the sidecar
# IMAGE_DPI=300            # assumed DPI for bare images lacking metadata
# DRY_RUN=true             # analyze + log but don't move files or write sidecars

# Cost ledger: USD per 1M tokens (defaults are gpt-4.1-mini list pricing).
# Update these if you change OPENAI_MODEL or pricing moves.
# OPENAI_INPUT_COST_PER_1M=0.40
# OPENAI_OUTPUT_COST_PER_1M=1.60

# Paths are set by docker-compose.yml; override only for non-Docker runs.
# INBOX_DIR=/data
# OUTPUT_DIR=/data/PROCESSED
# STATE_DIR=/data/scripts/state
